{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lndy",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "main": "./worker/index.mjs",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
